# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Service API Keys (for Edge Functions)
ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key  # Alternative to Anthropic

# Notion API (for Edge Functions)
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# Application Configuration
VITE_APP_NAME="AI Menu Refresh Platform"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Helping chefs refresh their menus using AI recommendations"

# Feature Flags
VITE_ENABLE_NOTION_INTEGRATION=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DARK_MODE=true

# AI Service Configuration
VITE_AI_SERVICE_PROVIDER=anthropic  # 'anthropic', 'openai', 'google'
VITE_AI_MODEL=claude-3-5-sonnet-20241022
VITE_AI_MAX_TOKENS=4000
VITE_AI_TEMPERATURE=0.7

# Rate Limiting
VITE_API_RATE_LIMIT=100  # requests per minute
VITE_AI_RATE_LIMIT=10    # AI requests per minute

# Supabase Edge Functions URLs
VITE_NOTION_IMPORTER_URL=https://your-project.supabase.co/functions/v1/notion-importer
VITE_RECOMMENDATION_GENERATOR_URL=https://your-project.supabase.co/functions/v1/recommendation-generator
